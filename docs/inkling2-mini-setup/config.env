# --- sampling & context (Unsloth guide) ---
TEMP=1.0
TOP_P=1.0
TOP_K=0
MIN_P=0.0
HOST=127.0.0.1
PORT=8080
N_GPU_LAYERS=99
PARALLEL=1
# Default context: Unsloth example. Long profile (131072) is UNVERIFIED opt-in.
CTX_SIZE_DEFAULT=32768
CTX_SIZE_LONG=131072
CTX_SIZE_LOADCHECK=512
CTX_SIZE_ZENBOOK=8192
# Model / config ceiling (CITED). Do not use as a default.
CTX_SIZE_MAX=1048576

# Zenbook MoE offload (general Unsloth tutorial pattern; Inkling-specific test: UNVERIFIED)
ZENBOOK_OVERRIDE_TENSOR=.ffn_.*_exps.=CPU

# Package policy: extra free disk beyond the chosen weight file, in bytes (8 GiB).
DISK_HEADROOM_BYTES=8589934592

# Non-interactive load/smoke timeouts (seconds). Uses timeout, gtimeout, or a bash fallback.
LOAD_TIMEOUT=300
SMOKE_TIMEOUT=300

